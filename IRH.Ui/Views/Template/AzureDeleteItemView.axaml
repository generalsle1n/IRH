<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="using:IRH.Ui.ViewModels.Template"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:lang="using:IRH.Ui.Resources"
             xmlns:icons="using:FluentIcons.Avalonia.Fluent"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModel:AzureDeleteItemViewModel"
             x:Class="IRH.Ui.Views.Template.AzureDeleteItemView">
    <StackPanel Spacing="10" MinWidth="381">
        <TextBlock Text="{x:Static lang:Strings.Azure_DeleteItem_Label}" FontWeight="Bold" />
        <!-- <Separator /> -->
        <Border Padding="5">
            <StackPanel Spacing="5">
                <ToggleSwitch IsChecked="{Binding ItemDeleteActive}" OnContent="{x:Static lang:Strings.Azure_DeleteItem_On_Label}" OffContent="{x:Static lang:Strings.Azure_DeleteItem_Off_Label}"/>
            </StackPanel>
        </Border>
        
        <Separator />
    </StackPanel>
</UserControl>
